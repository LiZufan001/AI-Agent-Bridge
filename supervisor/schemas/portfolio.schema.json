{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bridge/supervisor/schemas/portfolio.schema.json",
  "title": "Owner-selected Scheduled Supervisor portfolio",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "priority_rank",
          "owner_selected",
          "owner_paused"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "priority_rank": {
            "type": "integer",
            "minimum": 1
          },
          "owner_selected": {
            "type": "boolean"
          },
          "owner_paused": {
            "type": "boolean"
          },
          "pause_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "owner_paused": {
                  "const": true
                }
              },
              "required": [
                "owner_paused"
              ]
            },
            "then": {
              "required": [
                "pause_reason"
              ]
            }
          }
        ]
      }
    }
  }
}
