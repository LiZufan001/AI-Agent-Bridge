{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bridge/engine-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "kind",
    "runtime_relative"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol_version": {
      "const": 2
    },
    "kind": {
      "enum": [
        "private-state",
        "synthetic-state"
      ]
    },
    "runtime_relative": {
      "const": "worker/runtime"
    }
  }
}
